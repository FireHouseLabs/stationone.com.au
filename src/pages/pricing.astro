---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Pricing',
};
---

<Layout metadata={metadata}>
  <div class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="text-base text-primary dark:text-blue-200 font-semibold tracking-wide uppercase mb-2">Enterprise</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Organisation Pricing</h1>
        <p class="text-lg text-muted dark:text-slate-400 mb-8">
          Deploying StationOne across your sites, crews or units? We offer enterprise contracts for mining, private
          industry and government, with custom pricing tailored to your needs.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-10 text-left">
        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">Custom Subdomains</h3>
            <p class="text-muted dark:text-slate-400 text-sm">Branded access for your organisation</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">Private Database Hosting</h3>
            <p class="text-muted dark:text-slate-400 text-sm">Dedicated database infrastructure for your data</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">Private Object Storage</h3>
            <p class="text-muted dark:text-slate-400 text-sm">Secure, isolated storage for your files and media</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">OAuth SSO Integration</h3>
            <p class="text-muted dark:text-slate-400 text-sm">Single sign-on with your existing identity provider</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">Enhanced Security</h3>
            <p class="text-muted dark:text-slate-400 text-sm">
              Enterprise-grade security best practices and compliance
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <svg
            class="w-6 h-6 text-primary dark:text-blue-400 flex-shrink-0 mt-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <div>
            <h3 class="font-semibold mb-1">Dedicated Support</h3>
            <p class="text-muted dark:text-slate-400 text-sm">Priority support and onboarding assistance</p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/#contact" class="btn btn-primary text-lg px-8 py-3">Contact Us for Pricing</a>
      </div>
    </div>
  </div>

  <div class="bg-blue-50 dark:bg-slate-800 py-12">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold mb-3">Independent Volunteer Brigades</h2>
      <p class="text-lg text-muted dark:text-slate-400 mb-6">
        Running a single volunteer brigade or unit? StationOne is available to independent brigades too! Get in touch and we'll
        help you get set up.
      </p>
      <a href="/#contact" class="btn btn-secondary px-6 py-2">Get in Touch</a>
    </div>
  </div>
</Layout>
