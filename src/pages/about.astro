---
import Layout from '~/layouts/PageLayout.astro';

import Contact from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'About Us',
  description:
    'StationOne was built by people with real emergency services experience. Meet the team behind the platform keeping emergency response teams ready.',
};

const team = [
  {
    name: 'Jeremy West',
    initials: 'JW',
    photo: '/assets/jeremy.jpeg',
    role: 'Co-Founder and CTO',
    bio: [
      'Over 15 years as a software developer and digital product manager, specialising in staff management and building automation software.',
      'Jeremy is also an operational firefighter, a former Captain and Deputy Group Officer, with 12 years of volunteer emergency services experience.',
    ],
  },
  {
    name: 'Jason Bramston',
    initials: 'JB',
    photo: '/assets/jason.png',
    role: 'Co-Founder and Chief R&D Officer',
    bio: [
      'Over 20 years of experience in the emergency services field, spanning both professional and private sectors.',
      'Jason combines that background with a decade of expertise crafting tailored solutions, integrating technical design principles with enhancements customised for diverse environments.',
    ],
  },
  {
    name: 'David Breadmore',
    initials: 'DB',
    photo: '/assets/david.png',
    role: 'Strategic Partnerships & Commercial Management',
    bio: [
      'A solid and proven history of working with stakeholders across both government and private sectors, leading and motivating teams.',
      'David brings analytical and strategic management, a focus on sustainable business profitability, and a background in emergency management.',
    ],
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero / intro -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="text-base text-primary dark:text-blue-200 font-semibold tracking-wide uppercase mb-2">About Us</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6 font-heading">
        Built by emergency services, for emergency services
      </h1>
      <p class="text-xl text-muted dark:text-slate-400">
        StationOne was created by emergency services professionals who lived the problem first-hand: keeping people,
        equipment and records in order so teams are prepared to respond, operationally capable, and able to keep their
        communities safe.
      </p>
    </div>
  </section>

  <!-- Our story -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-5xl mx-auto px-4 grid gap-10 md:grid-cols-5 md:items-center">
      <div class="md:col-span-3">
        <h2 class="text-3xl font-bold mb-6 font-heading">Our story</h2>
        <div class="space-y-5 text-lg text-muted dark:text-slate-400">
          <p>
            Readiness doesn't happen on the day of an incident. It happens in the checks, inspections, training records
            and follow-up actions that sit behind every response. In too many brigades, stations and emergency response
            teams, that work lives in paper forms, Word documents and spreadsheets that are hard to keep current and
            harder to trust.
          </p>
          <p>
            Our founders know this because they've done the work. Between them they bring decades of experience across
            volunteer, professional and private-sector emergency services, from the fireground to the back office and
            from software to operations. They saw the same gap again and again: tools built for generic businesses, not
            for emergency response.
          </p>
          <p>
            StationOne is our answer. It's a single platform to manage inspections, equipment, qualifications, events
            and actions, designed with an understanding of how emergency teams actually operate. It's built for mining,
            industry and government organisations that need confidence their people and assets are ready.
          </p>
          <p>
            We're a FireHouse Labs platform, and we're still run by people who understand the job. When you talk to
            StationOne, you're talking to people who know what's at stake.
          </p>
        </div>
      </div>
      <figure class="md:col-span-2 max-w-sm mx-auto md:max-w-none">
        <img
          src="/assets/fire.jpeg"
          alt="A firefighter in yellow structural gear resting on the ground in a paddock under an orange, smoke-filled sky"
          width="480"
          height="640"
          loading="lazy"
          class="w-full h-auto rounded-md shadow-xl dark:shadow-none"
        />
        <figcaption class="mt-3 text-sm text-muted dark:text-slate-400">
          Jason Bramston, Co-Founder, on the fireground.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 md:py-24 bg-gray-50 dark:bg-slate-900/40">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <p class="text-base text-primary dark:text-blue-200 font-semibold tracking-wide uppercase mb-2">Our Team</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-heading">The people behind StationOne</h2>
        <p class="text-lg text-muted dark:text-slate-400">
          Operational experience, product expertise and a long track record working with emergency services
          organisations.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          team.map((person) => (
            <div class="flex flex-col p-6 rounded-md bg-white dark:bg-slate-900 shadow-lg dark:shadow-none dark:border dark:border-slate-700">
              {person.photo ? (
                <img
                  src={person.photo}
                  alt={person.name}
                  width="160"
                  height="160"
                  loading="lazy"
                  class="w-24 h-24 rounded-full object-cover mb-4"
                />
              ) : (
                <div
                  class="w-24 h-24 rounded-full bg-primary text-white flex items-center justify-center text-3xl font-bold mb-4"
                  aria-hidden="true"
                >
                  {person.initials}
                </div>
              )}
              <h3 class="text-xl font-bold font-heading">{person.name}</h3>
              <p class="text-primary dark:text-blue-300 font-semibold mb-4">{person.role}</p>
              <div class="space-y-3 text-muted dark:text-slate-400">
                {person.bio.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Contact
    id="contact"
    tagline="Get in Touch"
    title="Let’s talk about your team"
    subtitle="Tell us about your organisation and what you need to manage. Request a walkthrough, ask about pricing, or talk through your requirements with us."
  />
</Layout>
