---
import actionImage from '~/assets/images/actions-dashboard.png';
import FeaturePage from '~/components/widgets/FeaturePage.astro';
---

<FeaturePage
  name="Actions & tasks"
  title="Actions & Task Management for Emergency Teams"
  description="Turn inspection findings into assigned actions. Track maintenance, due dates and verification across your emergency response teams with StationOne."
  heading="Turn a reported issue into completed work."
  introduction="Give every fault and maintenance task a clear owner and a visible next step. StationOne connects inspection findings, team reports and follow-up work so your crews know what needs attention."
  benefits={[
    'Clear ownership for every action',
    'Visible progress and overdue work',
    'A record from report to verification',
  ]}
  image={{
    src: actionImage,
    alt: 'StationOne Actions dashboard with workload summaries, status filters and in-progress tasks',
    caption: 'The StationOne Actions dashboard: filter work by status and review ownership, priorities and due dates.',
  }}
  workflow={{
    title: 'From an inspection finding to a verified repair',
    description:
      'An equipment fault should start a follow-up process, with responsibility and progress visible to the team.',
    steps: [
      {
        title: 'Capture the issue',
        description: 'A failed inspection item creates an action, or a member records a maintenance request directly.',
      },
      {
        title: 'Assign and progress the work',
        description: 'Set an owner and due date, then move the action from Open to In Progress as work begins.',
      },
      {
        title: 'Resolve, then verify',
        description:
          'Mark the work Resolved when it is done. Review it before closing the action and retaining its history.',
      },
    ],
  }}
  capabilities={[
    {
      title: 'Connect findings to follow-up',
      description:
        'Create actions automatically from failed inspection items, missing components or expired items, so findings become tracked work.',
      icon: 'tabler:clipboard-check',
    },
    {
      title: 'Capture work outside inspections',
      description: 'Create actions for maintenance requests and issues reported during day-to-day operations.',
      icon: 'tabler:plus',
    },
    {
      title: 'Set ownership and due dates',
      description:
        'Assign work to team members, set completion dates and see overdue actions when reviewing priorities.',
      icon: 'tabler:calendar-due',
    },
    {
      title: 'Follow a clear lifecycle',
      description:
        'Use Open, In Progress, Resolved and Closed stages to distinguish work underway from work awaiting verification.',
      icon: 'tabler:list-check',
    },
    {
      title: 'Make unavailable equipment visible',
      description:
        'Record out-of-service status during maintenance and give the team visibility of equipment awaiting repair and verification.',
      icon: 'tabler:alert-triangle',
    },
    {
      title: 'Review the right workload',
      description:
        'Filter by assignee, unit, category or source to see your own work or review outstanding actions across the team.',
      icon: 'tabler:adjustments',
    },
    {
      title: 'Organise different types of work',
      description:
        'Group vehicle, equipment, stock, building, PPE, IT and other requests into categories that make follow-up easier.',
      icon: 'tabler:category',
    },
    {
      title: 'Offer public issue reporting',
      description:
        'Enable reporting without a login where appropriate, with a focused set of categories and control over whether public reporting is available.',
      icon: 'tabler:users',
    },
  ]}
  questions={[
    {
      title: 'Can we create an action without an inspection?',
      description:
        'Yes. Members can record maintenance requests and other issues directly, alongside actions generated from inspection findings.',
    },
    {
      title: 'What is the difference between Resolved and Closed?',
      description:
        'Resolved means the work has been completed and is awaiting verification. Closed records that the work has been reviewed and the action is complete.',
    },
    {
      title: 'Can members report an issue without logging in?',
      description:
        'Optional public reporting allows issues to be submitted through your public page without an account. You can enable or disable it to suit your team.',
    },
    {
      title: 'Can we see work assigned to a particular person or unit?',
      description:
        'Yes. Use the available views and filters to review individual workloads, unit actions, categories and sources.',
    },
  ]}
  related={[
    {
      title: 'Inspections & audits',
      description: 'Capture equipment condition and connect failed checks to the actions needed to address them.',
      href: '/features/inspections',
    },
    {
      title: 'Pre-plans',
      description: 'Keep site information organised and use review cycles to help keep plans current.',
      href: '/features/preplans',
    },
  ]}
/>
