---
import preplanImage from '~/assets/images/pre-plan.png';
import FeaturePage from '~/components/widgets/FeaturePage.astro';
---

<FeaturePage
  name="Pre-plans"
  title="Emergency Response Pre-Plans & Site Information"
  description="Bring site contacts, hazards, isolation points, maps and floor plans together. Build and review emergency response pre-plans with StationOne."
  heading="Know the site before your crew arrives."
  introduction="Bring site details, hazards, contacts and response information into one pre-plan. Give your emergency response team a shared reference for the places and risks they need to understand."
  benefits={[
    'Site information in a shared reference',
    'Hazards and isolation points on the map',
    'Review cycles to help keep plans current',
  ]}
  image={{
    src: preplanImage,
    alt: 'StationOne pre-plan showing site utilities, fire suppression details and map markers',
    caption: 'Bring site details and mapped resources together in a pre-plan.',
  }}
  workflow={{
    title: 'Build a plan your team can keep current',
    description:
      'Work with site stakeholders to gather the details, map the risks and maintain a useful shared record.',
    steps: [
      {
        title: 'Capture the site',
        description:
          'Record contacts, occupancy, building details and supporting documents with input from the people who know the location.',
      },
      {
        title: 'Map the critical details',
        description:
          'Locate hazards, isolation points and relevant site features, supported by photos and floor plans.',
      },
      {
        title: 'Share and review',
        description:
          'Share plans with the relevant units and use review reminders to revisit details as sites and risks change.',
      },
    ],
  }}
  capabilities={[
    {
      title: 'Keep site contacts and details together',
      description: 'Record addresses, coordinates, occupancy, operating hours and emergency contacts in one reference.',
      icon: 'tabler:building',
    },
    {
      title: 'Document the built environment',
      description: 'Capture building dimensions, construction materials, assembly areas and plant room locations.',
      icon: 'tabler:dimensions',
    },
    {
      title: 'Record dangerous goods',
      description:
        'Document UN numbers, shipping names, hazard classifications, quantities and storage locations for hazardous materials.',
      icon: 'tabler:biohazard',
    },
    {
      title: 'Locate isolation points',
      description:
        'Map electricity, gas, water and solar isolation points so their locations are documented with the site.',
      icon: 'tabler:power',
    },
    {
      title: 'Put risks on the map',
      description:
        'Position markers and draw zones for hazardous materials, exclusion areas and building outlines on satellite imagery.',
      icon: 'tabler:map-pin',
    },
    {
      title: 'Attach visual references',
      description: 'Store site photos, floor plans and supporting documents with descriptions and source information.',
      icon: 'tabler:photo',
    },
    {
      title: 'Keep reviews on the agenda',
      description: 'Use annual review cycles and automated reminders to prompt a check of existing plan details.',
      icon: 'tabler:calendar-repeat',
    },
    {
      title: 'Share with relevant teams',
      description:
        'Share plans across units within your organisation, with controls for sensitive information when publishing to public pages.',
      icon: 'tabler:lock',
    },
  ]}
  questions={[
    {
      title: 'What can we include in a pre-plan?',
      description:
        'Site and building details, emergency contacts, hazardous materials, isolation points, map markers, photos, floor plans and supporting documents can be kept together.',
    },
    {
      title: 'Can we mark hazards and isolation points on a map?',
      description:
        'Yes. Interactive mapping supports markers and polygon zones, helping your team locate relevant features and areas.',
    },
    {
      title: 'How do we keep plans up to date?',
      description:
        'Annual review cycles and automated reminders prompt your team to revisit a plan. Your team remains responsible for checking and updating its information.',
    },
    {
      title: 'Can multiple units use the same plan?',
      description:
        'Plans can be shared across units within your organisation. We can walk through sharing options and sensitive information controls for your requirements.',
    },
  ]}
  related={[
    {
      title: 'Inspections & audits',
      description: 'Capture equipment checks and retain the findings and supporting evidence in a structured record.',
      href: '/features/inspections',
    },
    {
      title: 'Actions & tasks',
      description: 'Assign follow-up work and track it from an open action through to verified completion.',
      href: '/features/actions',
    },
  ]}
/>
