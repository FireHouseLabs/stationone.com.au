---
import FeaturePage from '~/components/widgets/FeaturePage.astro';
---

<FeaturePage
  name="Calendar & events"
  title="Calendar, Training & Resource Scheduling for Emergency Teams"
  description="Coordinate training, events, vehicle bookings and room reservations in StationOne. Track attendance and resource availability across your emergency response team."
  heading="Get your people, vehicles and training on the same calendar."
  introduction="Plan the session, reserve the resources and see who is coming. Bring events, training and bookings together so your team spends less time coordinating separate lists and messages."
  benefits={[
    'Events and resources in one place',
    'Attendance responses without chasing messages',
    'Visibility of booking conflicts',
  ]}
  workflow={{
    title: 'Organise the next training session',
    description: 'Connect the event, the people attending and the resources they will need.',
    steps: [
      {
        title: 'Plan the session',
        description:
          'Create the training session with its time, location and capacity, then invite the relevant members.',
      },
      {
        title: 'Reserve the resources',
        description:
          'Assign vehicles or rooms to the session, with linked bookings and conflict checks to help manage availability.',
      },
      {
        title: 'Keep the team informed',
        description: 'Review RSVP responses, send reminders and track attendance against the scheduled activity.',
      },
    ],
  }}
  capabilities={[
    {
      title: 'Coordinate team events',
      description: 'Organise activities and manage invitations and responses alongside your operational calendar.',
      icon: 'tabler:calendar-event',
    },
    {
      title: 'Schedule training',
      description: 'Categorise sessions, manage capacity and record attendance to keep training activity organised.',
      icon: 'tabler:school',
    },
    {
      title: 'Book vehicles',
      description: 'Reserve vehicles with availability tracking, conflict detection and approval workflows.',
      icon: 'tabler:firetruck',
    },
    {
      title: 'Reserve rooms and facilities',
      description:
        'Coordinate shared spaces with capacity limits and booking approvals, with public booking access where enabled.',
      icon: 'tabler:door',
    },
    {
      title: 'Make responding easier',
      description: 'Members can respond to invitations directly from an email RSVP link without needing to log in.',
      icon: 'tabler:click',
    },
    {
      title: 'Keep people updated',
      description: 'Use invitations, group reminders and event-day notifications to keep members informed.',
      icon: 'tabler:bell',
    },
    {
      title: 'Spot overlapping bookings',
      description: 'Check for vehicle and room booking conflicts before they disrupt a planned activity.',
      icon: 'tabler:alert-triangle',
    },
    {
      title: 'Link resources to activities',
      description: 'Vehicles and rooms assigned to events or training create linked bookings that stay synchronised.',
      icon: 'tabler:link',
    },
  ]}
  questions={[
    {
      title: 'Can we book vehicles and rooms against a training session?',
      description:
        'Yes. Assigning these resources to an event or training session creates linked bookings, so the activity and resource reservations stay connected.',
    },
    {
      title: 'Do members need to log in to RSVP?',
      description: 'No. Email invitations include RSVP links so members can respond without logging in.',
    },
    {
      title: 'How are overlapping bookings handled?',
      description:
        'Vehicle and room bookings include conflict detection and visual indicators to help you identify scheduling overlaps.',
    },
    {
      title: 'Can we record who attended training?',
      description:
        'Yes. Training sessions include attendance tracking, alongside scheduling, categories and capacity management.',
    },
  ]}
  related={[
    {
      title: 'Actions & tasks',
      description: 'Give maintenance and follow-up work a clear owner and track it through to verification.',
      href: '/features/actions',
    },
    {
      title: 'Inspections & audits',
      description: 'Manage the routine checks that help your team understand equipment condition.',
      href: '/features/inspections',
    },
  ]}
/>
